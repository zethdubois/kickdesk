{
  "id": "kickagent",
  "port_family": 70,
  "primary_port": 7099,
  "ports": [
    { "role": "publish", "port": 7099 },
    { "role": "standalone", "port": 7098 }
  ],
  "url": "http://127.0.0.1:7099/manifest.json",
  "workflows": {
    "start": ["build", "publish", "up"],
    "stop": ["stop-server"]
  },
  "commands": {
    "up": "pnpm serve-publish -- --dir publish --port 7099",
    "down": "true",
    "build": "pnpm build",
    "test": "pnpm test",
    "bundle": "pnpm bundle",
    "publish": "node dist/cli.js publish --out-dir publish --base-url http://127.0.0.1:7099",
    "stop-server": "fuser -k 7099/tcp 2>/dev/null || true; fuser -k 7098/tcp 2>/dev/null || true"
  }
}
