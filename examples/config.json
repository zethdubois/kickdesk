{
  "app_order": ["publicweb", "kickagent", "merch-api"],
  "apps": {
    "publicweb": {
      "path": "~/projects/publicweb",
      "port_family": 50,
      "primary_port": 5000,
      "ports": [
        { "role": "app", "port": 5000 },
        { "role": "db", "port": 5043 }
      ],
      "url": "http://localhost:5000",
      "workflows": {
        "start": ["db-up", "migrate", "up"],
        "stop": ["stop-server", "db-down"]
      },
      "commands": {
        "up": "pnpm dev",
        "down": "pnpm db:down",
        "build": "pnpm build",
        "test": "pnpm check",
        "db": "pnpm db:status",
        "db-up": "pnpm db:up",
        "db-down": "pnpm db:down",
        "migrate": "pnpm db:migrate",
        "migrate-status": "pnpm db:migrate:status",
        "stop-server": "fuser -k 5000/tcp 2>/dev/null || true"
      }
    },
    "kickagent": {
      "path": "~/projects/kickagent",
      "port_family": 70,
      "primary_port": 7099,
      "ports": [
        { "role": "publish", "port": 7099 },
        { "role": "standalone", "port": 7098 }
      ],
      "url": "http://127.0.0.1:7099/manifest.json",
      "workflows": {
        "start": ["build", "publish", "up"],
        "stop": ["stop-server"]
      },
      "commands": {
        "up": "pnpm serve-publish -- --dir publish --port 7099",
        "down": "true",
        "build": "pnpm build",
        "test": "pnpm test",
        "bundle": "pnpm bundle",
        "publish": "node dist/cli.js publish --out-dir publish --base-url http://127.0.0.1:7099",
        "stop-server": "fuser -k 7099/tcp 2>/dev/null || true; fuser -k 7098/tcp 2>/dev/null || true"
      }
    },
    "merch-api": {
      "path": "~/projects/merch-api",
      "port_family": 80,
      "primary_port": 8000,
      "ports": [
        { "role": "api", "port": 8000 },
        { "role": "gateway", "port": 8001 },
        { "role": "db", "port": 8043 }
      ],
      "url": "http://localhost:8000/docs",
      "workflows": {
        "start": ["db", "migrate", "up"],
        "stop": ["stop-api", "stop-gateway", "down"]
      },
      "commands": {
        "up": "make local-api-run",
        "down": "make local-db-down",
        "build": "make setup",
        "health": "make local-health",
        "ready": "make local-ready",
        "db": "make local-db-up",
        "db-reset": "make local-db-reset",
        "migrate": "make local-migrate",
        "migrate-status": "make local-migrate-status",
        "gateway": "make local-gateway-run",
        "stop-api": "fuser -k 8000/tcp 2>/dev/null || true",
        "stop-gateway": "fuser -k 8001/tcp 2>/dev/null || true"
      }
    }
  }
}
